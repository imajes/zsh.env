#autoload
msgvault() {
  emulate -L zsh

  # $commands resolves the external executable even though this function has
  # the same name. Keep the explicit override for account-specific installations.
  local msgvault_bin="${MSGVAULT_BIN:-${commands[msgvault]:-}}"
  local client_secret="$HOME/.config/msgvault/client_secret.json"
  local restore_helper="$HOME/bin/restore-msgvault-client-secret.zsh"

  if [[ -z $msgvault_bin || ! -x "$msgvault_bin" ]]; then
    print -u2 "msgvault binary not found or not executable: ${msgvault_bin:-PATH}"
    return 127
  fi

  if [[ ! -r "$client_secret" ]]; then
    if [[ ! -x "$restore_helper" ]]; then
      print -u2 "msgvault client secret is missing and restore helper is unavailable: $restore_helper"
      return 1
    fi
    "$restore_helper" >/dev/null || return
  fi

  "$msgvault_bin" "$@"
}
