#autoload
# files-from [-t mtime|ctime|either] [-0] [-p] <1980s|1980|1980-1989> [PATH]
# Bare years retain the existing ten-year range. Explicit ranges include both
# named years: local midnight at start <= timestamp < midnight after end year.
# -0 always emits only raw filenames and NULs. Human output quotes filenames.
emulate -L zsh
setopt pipefail
local basis=mtime nulldelim=0 verbose=0 OPTIND=1 OPTARG opt spec root
while getopts ':t:0p' opt; do
  case $opt in
    t) basis=$OPTARG ;;
    0) nulldelim=1 ;;
    p) verbose=1 ;;
    *) print -ru2 -- 'usage: files-from [-t mtime|ctime|either] [-0] [-p] <1980s|1980|1980-1989> [PATH]'; return 2 ;;
  esac
done
shift $((OPTIND-1))
(( $# >= 1 && $# <= 2 )) || { print -ru2 -- 'files-from: expected a year range and optional path'; return 2; }
spec=$1 root=${2:-.}
local -i start_year end_year
if [[ $spec == [0-9][0-9][0-9][0-9]s ]]; then
  start_year=$((10#${spec%s})); end_year=$((start_year+10))
elif [[ $spec == [0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9] ]]; then
  start_year=$((10#${spec%-*})); end_year=$((10#${spec#*-}+1))
elif [[ $spec == [0-9][0-9][0-9][0-9] ]]; then
  start_year=$((10#$spec)); end_year=$((start_year+10))
else
  print -ru2 -- "files-from: invalid year range: $spec"; return 2
fi
(( start_year >= 1 && end_year > start_year && end_year <= 9999 )) || {
  print -ru2 -- 'files-from: invalid year boundaries'; return 2
}
[[ $basis == (mtime|ctime|either) ]] || { print -ru2 -- "files-from: invalid time basis: $basis"; return 2; }
zmodload -F zsh/stat b:zstat && zmodload zsh/datetime || return 1
local start_epoch end_epoch
strftime -r -s start_epoch '%Y-%m-%d %H:%M:%S' "${start_year}-01-01 00:00:00" || return
strftime -r -s end_epoch '%Y-%m-%d %H:%M:%S' "${end_year}-01-01 00:00:00" || return
# A leading dash must be a pathname, not a find expression.
[[ $root == -* ]] && root="./$root"
command find "$root" -type f -print0 | {
  local file mdate cdate format='%Y-%m-%d'
  local -i match_m match_c scan_failed=0
  local -A metadata
  (( verbose )) && format='%Y-%m-%d %H:%M:%S %z'
  while IFS= read -r -d '' file; do
    zstat -H metadata -- "$file" || { scan_failed=1; continue; }
    (( match_m = metadata[mtime] >= start_epoch && metadata[mtime] < end_epoch ))
    (( match_c = metadata[ctime] >= start_epoch && metadata[ctime] < end_epoch ))
    case $basis in
      mtime) (( match_m )) || continue ;;
      ctime) (( match_c )) || continue ;;
      either) (( match_m || match_c )) || continue ;;
    esac
    if (( nulldelim )); then
      printf '%s\0' "$file"
    else
      strftime -s mdate "$format" "$metadata[mtime]"
      strftime -s cdate "$format" "$metadata[ctime]"
      if (( verbose )) || [[ $basis == either ]]; then
        printf 'mtime=%s ctime=%s %q\n' "$mdate" "$cdate" "$file"
      else
        [[ $basis == ctime ]] && mdate=$cdate
        printf '%s %q\n' "$mdate" "$file"
      fi
    fi
  done
  (( ! scan_failed ))
}
