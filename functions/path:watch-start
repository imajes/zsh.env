#autoload
# Observe PATH after normal hook dispatch; never invoke another hook ourselves.
emulate -L zsh
autoload -Uz add-zsh-hook
if (( ${precmd_functions[(Ie)path:_watch_precmd]} )); then
  return 0
fi
typeset -g _PATH_WATCH_LOG=${PATH_WATCH_LOG:-${XDG_CACHE_HOME:-$HOME/.cache}/zsh/path-watch.log}
command mkdir -p -- "${_PATH_WATCH_LOG:h}" || return
typeset -ga _PATH_WATCH_BEFORE=("${path[@]}")

path:_watch_observe() {
  emulate -L zsh
  local event=$1 entry
  [[ ${(pj:\0:)_PATH_WATCH_BEFORE} == ${(pj:\0:)path} ]] && return 0
  {
    print -r -- "PATH changed at $event"
    for entry in "${path[@]}"; do
      (( ${_PATH_WATCH_BEFORE[(Ie)$entry]} )) || printf '  + %q\n' "$entry"
    done
    for entry in "${_PATH_WATCH_BEFORE[@]}"; do
      (( ${path[(Ie)$entry]} )) || printf '  - %q\n' "$entry"
    done
    print -r -- '  new PATH:'
    printf '    %q\n' "${path[@]}"
  } >> "$_PATH_WATCH_LOG"
  _PATH_WATCH_BEFORE=("${path[@]}")
  return 0
}
path:_watch_precmd() { path:_watch_observe precmd; }
path:_watch_chpwd() { path:_watch_observe chpwd; }
add-zsh-hook precmd path:_watch_precmd
add-zsh-hook chpwd path:_watch_chpwd
print -r -- "PATH watch: ON (log -> $_PATH_WATCH_LOG)"
