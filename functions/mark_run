#autoload
# Run an external command with metadata-only logs and owned process supervision.
emulate -L zsh
local helper="${functions_source[mark_run]:A:h:h}/libexec/mark-run.py"
if (( ! $+commands[python3] )); then
  print -ru2 -- 'mark_run: python3 is required'
  return 127
fi
command python3 "$helper" "$@"
