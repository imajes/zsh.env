#autoload
#compdef mark_run
mark_run() {
  local timeout=""
  local category=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t|--timeout)
        timeout="${2:?missing timeout value}"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      -*)
        print -u2 "mark_run: unknown option: $1"
        return 2
        ;;
      *)
        category="$1"
        shift
        ;;
    esac
  done

  if [[ -z "$category" || $# -eq 0 ]]; then
    print -u2 "usage: mark_run [-t seconds] CATEGORY -- command [args...]"
    return 2
  fi

  local subsystem="${MARK_LOG_SUBSYSTEM:-mn.foxes.mark}"
  local run_id
  local start_epoch
  local end_epoch
  local duration
  local exit_code
  local pid
  local timer_pid=""
  local timed_out=0
  local rendered=""
  local arg

  run_id="$(uuidgen)"
  start_epoch="$(date '+%s')"

  for arg in "$@"; do
    rendered+="${(q)arg} "
  done
  rendered="${rendered% }"

  osmark \
    --subsystem "$subsystem" \
    --category "$category" \
    --level default \
    -- "[mark_log] ${category} START run_id=${run_id} command=${rendered}"

  "$@" &
  pid=$!

  if [[ -n "$timeout" ]]; then
    (
      sleep "$timeout"

      if kill -0 "$pid" 2>/dev/null; then
        osmark \
          --subsystem "$subsystem" \
          --category "$category" \
          --level error \
          -- "[mark_log] ${category} TIMEOUT run_id=${run_id} after=${timeout}s pid=${pid}"

        kill -TERM "$pid" 2>/dev/null

        sleep 2

        if kill -0 "$pid" 2>/dev/null; then
          osmark \
            --subsystem "$subsystem" \
            --category "$category" \
            --level fault \
            -- "[mark_log] ${category} TIMEOUT_FORCE_KILL run_id=${run_id} pid=${pid}"

          kill -KILL "$pid" 2>/dev/null
        fi
      fi
    ) &
    timer_pid=$!
  fi

  wait "$pid"
  exit_code=$?

  if [[ -n "$timer_pid" ]]; then
    kill "$timer_pid" 2>/dev/null
    wait "$timer_pid" 2>/dev/null
  fi

  case "$exit_code" in
    137|143)
      timed_out=1
      ;;
  esac

  end_epoch="$(date '+%s')"
  duration=$(( end_epoch - start_epoch ))

  osmark \
    --subsystem "$subsystem" \
    --category "$category" \
    --level default \
    -- "[mark_log] ${category} END run_id=${run_id} status=${exit_code} duration=${duration}s timed_out=${timed_out}"

  return "$exit_code"
}
