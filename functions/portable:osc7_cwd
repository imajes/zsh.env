#autoload
emulate -L zsh
[[ -o interactive && -t 1 ]] || return 0
[[ -n ${OSC7_DISABLE:-} || $TERM == (dumb|linux) ]] && return 0

# Encode UTF-8 bytes, including percent and all terminal control characters.
local LC_ALL=C value encoded character hex host directory
for value in "${OSC7_HOST:-$HOST}" "$PWD"; do
  encoded=''
  for character in ${(s::)value}; do
    if [[ $character == [a-zA-Z0-9._~-] || ( -n $host && $character == / ) ]]; then
      encoded+=$character
    else
      builtin printf -v hex '%02X' "'$character"
      encoded+="%$hex"
    fi
  done
  if [[ -z $host ]]; then host=$encoded; else directory=$encoded; fi
done
builtin printf '\033]7;file://%s%s\033\\' "$host" "$directory"
